(* Verification feature: tuple wildcard equalities in assumptions are lowered
   to tuple bindings and checks of fixed components; wildcards are ignored.

   Reviewed.
*)


const fresh message
const fresh key1
const fresh key2

type proc_t : process

process all_wildcard_worker() : proc_t
{
  main {
    assume [_ = 1, 2 = _, _ = _, _ = (1, _), (_, 2) = _] in
    var value = (1, 2) in
    assume [value = (_, _)] in
    event [::TupleMatched()]
  }
}

process overlapping_worker() : proc_t
{
  main {
    assume [(_, key1) = (message, _)] in
    event [::OverlappingPatternsMatched()]
  }
}

process tuple_worker() : proc_t
{
  main {
    var ciphertext = (message, key1) in
    assume [ciphertext = (_, key1)] in
    event [::TupleConstructorMatched()]
  }
}

process tuple_conflicting_worker() : proc_t
{
  main {
    var ciphertext = (message, key1) in
    assume [ciphertext = (_, key2)] in
    event [::TupleConstructorConflictMatched()]
  }
}

process conflicting_worker() : proc_t
{
  main {
    assume [(_, key1) = (message, key2)] in
    event [::ConflictingPatternsMatched()]
  }
}

system
  all_wildcard_worker()
  | overlapping_worker()
  | tuple_worker()
  | tuple_conflicting_worker()
  | conflicting_worker()
requires
[
  (* PROVERIF EXPECTED
  # A tuple value matches a tuple of wildcards.
  true
  *)
  lemma TuplePatternMatches : (* verified *)
    reachable ::TupleMatched() ;

  (* PROVERIF EXPECTED
  # The two tuple patterns overlap at (message, key1).
  true
  *)
  lemma TwoWildcardPatternsOverlap : (* verified *)
    reachable ::OverlappingPatternsMatched() ;

  (* PROVERIF EXPECTED
  # The private matcher recognizes a tuple while ignoring one argument.
  true
  *)
  lemma TupleConstructorPatternMatches : (* verified *)
    reachable ::TupleConstructorMatched() ;

  (* PROVERIF EXPECTED
  # The private matcher still checks the tuple's fixed key argument.
  false
  *)
  lemma TupleConstructorPatternChecksFixedArguments : (* falsified *)
    reachable ::TupleConstructorConflictMatched() ;

  (* PROVERIF EXPECTED
  # Fresh key1 and key2 cannot satisfy the conflicting fixed positions.
  false
  *)
  lemma ConflictingPatternsDoNotMatch : (* falsified *)
    reachable ::ConflictingPatternsMatched()
]
