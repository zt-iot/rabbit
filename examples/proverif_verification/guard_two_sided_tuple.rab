(* Two-sided tuples are decomposed into constraints. Bind only variables
   whose values are supplied by a ground expression or another guard. *)
type proc_t : process
process assumptions() : proc_t {
  main {
    assume [(x, 2) = (1, y)] in event [::Basic(x, y)];
    assume [a != b, ((a, _), b) = ((1, c), 2), c = 3] in
    event [::Nested(a, b, c)];
    assume [(u, v) = (v, w), w = 4] in event [::Chain(u, v, w)]
  }
}
process cases() : proc_t {
  main {
    case
    | [(x, x, 3) = (1, 2, y)] -> event [::Bad()]
    | [(x, x, 3) = (1, 1, y)] -> event [::Repeated(x, y)]
    end
  }
}
process loop() : proc_t {
  main {
    var state = 0 in
    repeat [(x, 1) = (state, y), x = 0] ->
      event [::Loop(x, y)]; state := y
    until [(x, 2) = (state, y), x = 1] -> event [::Exit(x, y)] end
  }
}
system assumptions() | cases() | loop()
requires [
  (* PROVERIF EXPECTED
  true
  *)
  lemma Basic : reachable ::Basic(1, 2);
  (* PROVERIF EXPECTED
  true
  *)
  lemma Nested : reachable ::Nested(1, 2, 3);
  (* PROVERIF EXPECTED
  true
  *)
  lemma Chain : reachable ::Chain(4, 4, 4);
  (* PROVERIF EXPECTED
  false
  *)
  lemma Bad : reachable ::Bad();
  (* PROVERIF EXPECTED
  true
  *)
  lemma Repeated : reachable ::Repeated(1, 3);
  (* PROVERIF EXPECTED
  true
  *)
  lemma Loop : reachable ::Loop(0, 1);
  (* PROVERIF EXPECTED
  true
  *)
  lemma Exit : reachable ::Exit(1, 2)
]
