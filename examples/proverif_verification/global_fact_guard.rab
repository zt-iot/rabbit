fact global [Stored:1]
tag global [Consumed:0]

const fresh payload

type proc_t : process

process worker() : proc_t
{
  main {
    case
    | [::Stored(payload)] -> event [::Consumed()]
    end
  }
}

system worker()
requires
[
  (* PROVERIF EXPECTED
  false
  *)
  lemma ConsumedIsReachable : (* falsified *) reachable ::Consumed()
]
