(* An unused parameterized channel declaration is supported. *)

type proc_t : process
type transport_t : channel

channel transport<> : transport_t

process worker() : proc_t
{
  main { event [::Ready()] }
}

system worker()
requires
[
  (* PROVERIF EXPECTED
  true
  *)
  lemma ReadyIsReachable : (* verified *) reachable ::Ready()
]
