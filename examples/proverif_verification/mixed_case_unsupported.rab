(* Known gap: channel and non-channel branches cannot share a case. *)

type proc_t : process
type transport_t : channel

process worker(ch : transport_t) : proc_t
{
  main {
    case
    | [ch::Message(value)] -> event [::ChannelBranch(value)]
    | [1 = 1] -> event [::EquationBranch()]
    end
  }
}

allow proc_t transport_t [.]
channel transport : transport_t

system worker(transport)
requires
[
  lemma EquationBranchIsReachable : (* verified *) reachable ::EquationBranch()
]
