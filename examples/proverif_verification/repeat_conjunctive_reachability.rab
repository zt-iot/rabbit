tag global [A:0, B:0]
fact channel [Exit:0]

(* Regression: publishing the loop continuation before the final channel
   output lets ProVerif reconstruct either order of this conjunction.
   The reverse-order query returned unknown before loop-tail lowering. *)

type proc_t : process
type channel_t : channel

process worker(ch : channel_t) : proc_t
{
  main {
    repeat
    | [] ->
        event [::A()];
        put [ch::Exit()]
    until
    | [ch::Exit()] -> skip
    end;
    event [::B()]
  }
}

allow proc_t channel_t [.]

channel loopback : channel_t

system worker(loopback)
requires
[
  (* PROVERIF EXPECTED
  true
  *)
  lemma ReverseOrderIsReachable : (* verified *)
    reachable ::B(), ::A() ;

  (* PROVERIF EXPECTED
  true
  *)
  lemma ExecutionOrderIsReachable : (* verified *)
    reachable ::A(), ::B()
]
