(* Verification feature: a process-local function returns into its caller.

   Reviewed.
*)

const fresh argument

type proc_t : process

process worker() : proc_t
{
  function identity(value) {
    event [::HelperCalled(value)];
    value
  }

  main {
    var result = identity(argument) in
    event [::Returned(result)]
  }
}

system
  worker()
requires
[
  (* PROVERIF EXPECTED
  # The local function is called
  true
  *)
  lemma HelperRuns : (* verified *)
    reachable ::HelperCalled(value) ;

  (* PROVERIF EXPECTED
  # The local function return is correct
  true
  *)
  lemma ReturnValueFlowsToCaller : (* verified *)
    reachable ::Returned(argument)
]
