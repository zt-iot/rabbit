tag global [Value:1]

(* Negative test: declaring an operator with [function +:2] is rejected by
   the parser, which requires an ordinary name in a function declaration.
   The expected result is the diagnostic in the sibling .error file, not the
   reachability marker below. *)

function +:2

type proc_t : process

process worker() : proc_t
{
  main { event [::Value(1 + 2)] }
}

system worker()
requires
[
  lemma ValueIsReachable : (* verified *) reachable ::Value(1 + 2)
]
