tag global [Continued:0]

(* Regression: a syscall returning () must type-check as Unit and continue. *)
(* PROVERIF EXPECTED
true
*)

type proc_t : process

syscall unit_value() {
  ()
}

allow proc_t [unit_value]

process worker() : proc_t
{
  main {
    _ := unit_value();
    event [::Continued()]
  }
}

system
  worker()
requires
[
  lemma UnitReturnContinues : (* verified *)
    reachable ::Continued()
]
