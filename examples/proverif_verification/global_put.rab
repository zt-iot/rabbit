(* BUG: In Rabbit, `put [::Recorded()]` creates a linear global fact. It does
   not execute `event [::Recorded()]`. The fact may subsequently be consumed
   by a `case` guard, whereas a ProVerif event is an observation and cannot be
   consumed.

   The current ProVerif compiler incorrectly lowers every non-`Out` global
   fact in `put` to `event Recorded()`. It therefore conflates two distinct
   Rabbit commands and reports the query below as reachable. Under the
   intended Rabbit semantics, the lemma below is `false`: no `Recorded` event
   should have occurred.

   A proper fix must encode linear global-fact production, consumption, and
   reachability without turning the fact into an event. Keep this expectation
   failing until that encoding is implemented. *)

type proc_t : process

process worker() : proc_t
{
  main {
    put [::Recorded()]
  }
}

system
  worker()
requires
[
  (* PROVERIF EXPECTED
  # Rabbit `put` creates a linear global fact rather than an event, so no `Recorded` event should occur.
  false
  *)
  lemma PutRecordsGlobalFact :
    reachable ::Recorded()
]
