tag global [Equal:2, Unequal:2]

tag global [AfterTrueEquality:0, AfterTrueInequality:0, InsideFalseEquality:0, AfterFalseEquality:0, InsideFalseInequality:0, AfterFalseInequality:0]

(* Comparisons are guard conditions; ordinary tags record their successful
   evaluation for reachability and correspondence queries. *)

const fresh left
const fresh right

type proc_t : process

process true_comparisons() : proc_t
{
  main {
    case [left = left] -> event [::Equal(left, left)] end;
    event [::AfterTrueEquality()];
    case [left != right] -> event [::Unequal(left, right)] end;
    event [::AfterTrueInequality()]
  }
}

process false_equality() : proc_t
{
  main {
    case [left = right] -> event [::InsideFalseEquality(), ::Equal(left, right)] end;
    event [::AfterFalseEquality()]
  }
}

process false_inequality() : proc_t
{
  main {
    case [left != left] -> event [::InsideFalseInequality(), ::Unequal(left, left)] end;
    event [::AfterFalseInequality()]
  }
}

system
  true_comparisons() | false_equality() | false_inequality()
requires
[
  (* PROVERIF EXPECTED
  true
  *)
  lemma TrueEqualityIsReachable : (* verified *)
    reachable ::Equal(left, left) ;

  (* PROVERIF EXPECTED
  true
  *)
  lemma TrueEqualityContinues : (* verified *)
    reachable ::AfterTrueEquality() ;

  (* PROVERIF EXPECTED
  true
  *)
  lemma TrueInequalityIsReachable : (* verified *)
    reachable ::Unequal(left, right) ;

  (* PROVERIF EXPECTED
  true
  *)
  lemma TrueInequalityContinues : (* verified *)
    reachable ::AfterTrueInequality() ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseEqualityIsUnreachable : (* falsified *)
    reachable ::Equal(left, right) ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseEqualitySuppressesWholeEvent : (* falsified *)
    reachable ::InsideFalseEquality() ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseEqualityBlocks : (* falsified *)
    reachable ::AfterFalseEquality() ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseInequalityIsUnreachable : (* falsified *)
    reachable ::Unequal(left, left) ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseInequalitySuppressesWholeEvent : (* falsified *)
    reachable ::InsideFalseInequality() ;

  (* PROVERIF EXPECTED
  false
  *)
  lemma FalseInequalityBlocks : (* falsified *)
    reachable ::AfterFalseInequality()
]
