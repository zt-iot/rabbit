(* Verification feature: syscalls write and consume process-local file facts
   under explicit access-control entries. *)

syscall write_file(p, contents) {
  put [p.contents]
}

syscall read_file(p) {
  case
  | [p.contents] -> contents
  end
}

type server_t : process
type writable_t : filesys

allow server_t writable_t [write_file, read_file]

process server() : server_t
{
  file "/data" : writable_t = "initial"

  main {
    (* Keep process initialization separate from the first filesystem syscall,
       so its access-control entries exist before that access is checked. *)
    event [::Initialized()];
    _ := write_file("/data", "updated");
    var first = read_file("/data") in
    event [::ReadBack(first)];
    var second = read_file("/data") in
    event [::ReadBackAgain(second)]
  }
}

system
  server()
requires
[
  (* PROVERIF EXPECTED
  # Writing adds `"updated"` without removing the initial file fact, so the
  # first read may consume `"initial"`.
  true
  *)
  lemma InitialContentsAreReadable : (* verified *)
    reachable ::ReadBack("initial") ;

  (* PROVERIF EXPECTED
  # The first read may instead consume the newly written contents.
  true
  *)
  lemma UpdatedContentsAreReadable : (* verified *)
    reachable ::ReadBack("updated") ;

  (* PROVERIF EXPECTED
  # If the second read consumes `"updated"`, the first read must have consumed
  # the only other file fact, `"initial"`.
  true
  *)
  lemma ContentsAreReadableAgain : (* verified *)
    corresponds ::ReadBackAgain("updated") ~> ::ReadBack("initial")
]
