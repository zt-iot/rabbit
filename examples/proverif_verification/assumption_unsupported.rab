(* Known gap: assume syntax is not accepted by this compiler path.

   Reviewed: TODO: Rabbit parser does not support assume. Need to rebase on the version with it.
*)

type proc_t : process

process worker() : proc_t
{
  main {
    assume [1 = 1];
    event [::Ready()]
  }
}

system worker()
requires
[
  lemma ReadyIsReachable : reachable ::Ready()
]
