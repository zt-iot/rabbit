fact local [Flag:0]
tag global [Selected:0]

type proc_t : process

process worker() : proc_t
{
  main {
    case
    | [Flag()] -> event [::Selected()]
    end
  }
}

system worker()
requires
[
  (* PROVERIF EXPECTED
  false
  *)
  lemma SelectedIsReachable : (* falsified *) reachable ::Selected()
]
