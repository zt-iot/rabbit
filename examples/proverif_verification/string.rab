(* Verification feature: string literals denote stable symbolic constants.

   Reviewed.
*)

type proc_t : process

process speaker() : proc_t
{
  main {
    event [::Seen("hello")]
  }
}

system
  speaker()
requires
[
  (* PROVERIF EXPECTED
  # The emitted string literal and the queried literal map to the same symbolic constant.
  true
  *)
  lemma HelloIsReachable : (* verified *)
    reachable ::Seen("hello") ;

  (* PROVERIF EXPECTED
  # A different string literal maps to a distinct symbolic constant that is never emitted.
  false
  *)
  lemma OtherStringIsUnreachable : (* falsified *)
    reachable ::Seen("other")
]
