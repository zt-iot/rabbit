(* Known gap: passive attack semantics are not implemented by the ProVerif compiler.

   This is simply a not-implemented-yet stuff.
*)

passive attack observe(value)
{
  event [::Observed(value)]
}

type proc_t : process

process worker() : proc_t
{
  main { _ := observe("payload") }
}

system worker()
requires
[
  lemma ObservationIsReachable : reachable ::Observed("payload")
]
