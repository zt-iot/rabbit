(* Known gap: ProVerif event lowering does not support channel facts. *)

const fresh payload

type proc_t : process
type transport_t : channel

process worker(ch : transport_t) : proc_t
{
  main {
    event [ch::Observed(payload)]
  }
}

channel transport : transport_t

system worker(transport)
requires
[
  lemma ModelRuns : (* falsified *) reachable ::Never()
]
