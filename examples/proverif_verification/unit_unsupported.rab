(* BUG: The parser represents `()` as an empty tuple, but Typer asserts that
   every tuple is nonempty instead of converting it to `Typed.Unit`.  This
   crashes with `Assertion failed` before ProVerif compilation. *)

type proc_t : process

syscall unit_value() {
  ()
}

allow proc_t [unit_value]

process worker() : proc_t
{
  main {
    _ := unit_value();
    event [::Continued()]
  }
}

system
  worker()
requires
[
  lemma UnitReturnContinues : (* verified *)
    reachable ::Continued()
]
