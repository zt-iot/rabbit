tag global [Equal:2, Unequal:2]

tag global [BeforeInequality:2, AfterInequality:2]

(* Rejection regression: Eq/Neq event facts are no longer supported.
   Compilation must fail at event lowering, before these queries are checked. *)

const fresh left
const fresh right

type proc_t : process

process worker() : proc_t
{
  main {
    event [::BeforeInequality(left, right)];
    case [left != right] -> event [::Unequal(left, right)] end;
    event [::AfterInequality(left, right)]
  }
}

system worker()
requires
[
  lemma InequalityIsReachable :
    reachable left != right ;

  lemma InequalityHasPredecessor :
    corresponds left != right ~> ::BeforeInequality(left, right) ;

  lemma InequalityPrecedesContinuation :
    corresponds ::AfterInequality(left, right) ~> left != right
]
