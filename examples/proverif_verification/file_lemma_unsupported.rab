(* File facts have no event or query semantics and must be rejected by the typer. *)

type proc_t : process
type file_t : filesys

process worker() : proc_t
{
  file "/data" : file_t = "value"
  main { skip }
}

system worker()
requires
[
  lemma FileIsReachable : (* verified *) reachable "/data".value
]
