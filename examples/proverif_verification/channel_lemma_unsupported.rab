(* Known gap: channel facts cannot be lowered in ProVerif queries. *)

type proc_t : process
type transport_t : channel

process worker(ch : transport_t) : proc_t
{
  main { skip }
}

allow proc_t transport_t [.]
channel transport : transport_t

system worker(transport)
requires
[
  lemma MessageIsReachable : (* verified *) reachable transport::Message(value)
]
