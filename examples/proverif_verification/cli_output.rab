(* Regression: rabbit_proverif -o writes the generated ProVerif program. *)

type proc_t : process

tag [Started:0]

process worker() : proc_t {
  main {
    event [::Started()]
  }
}

system worker()
requires [
  (* PROVERIF EXPECTED
  true
  *)
  lemma StartedIsReachable : (* verified *)
    reachable ::Started()
]
