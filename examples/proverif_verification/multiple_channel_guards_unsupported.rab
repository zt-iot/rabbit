(* Known gap: one case branch cannot consume two channel facts. *)

type proc_t : process
type transport_t : channel

process worker(left : transport_t, right : transport_t) : proc_t
{
  main {
    case
    | [left::Message(x), right::Message(y)] -> event [::Both(x, y)]
    end
  }
}

allow proc_t transport_t [.]
channel left : transport_t
channel right : transport_t

system worker(left, right)
requires
[
  lemma BothAreReachable : reachable ::Both(x, y)
]
