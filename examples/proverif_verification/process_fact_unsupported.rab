fact process [State:1]
tag global [Ready:0]

(* Negative test: process fact declarations receive an explicit unsupported
   diagnostic rather than an assertion failure. *)

type proc_t : process

process worker() : proc_t
{
  main {
    case
    | [worker % State(value)] -> event [::Ready()]
    end
  }
}

system worker()
requires
[
  lemma ReadyIsReachable : reachable ::Ready()
]
