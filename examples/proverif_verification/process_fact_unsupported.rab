fact process [State:1]
tag global [Ready:0]

(* Known gap: process facts are parsed but unused by the Typed AST. *)

type proc_t : process

process worker() : proc_t
{
  main {
    case
    | [worker % State(value)] -> event [::Ready()]
    end
  }
}

system worker()
requires
[
  lemma ReadyIsReachable : (* verified *) reachable ::Ready()
]
