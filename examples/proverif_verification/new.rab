(* Verification feature: new creates a value usable by the continuation.

   Reviewed.
*)

type proc_t : process

process maker() : proc_t
{
  main {
    new value in
    event [::Created(value)]
  }
}

system
  maker()
requires
[
  (* PROVERIF EXPECTED
  # The fresh value generated by `new` is passed directly to `Created`.
  true
  *)
  lemma CreatedIsReachable :
    reachable ::Created(some_value)
]
