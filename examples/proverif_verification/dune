(executable
 (name test_proverif_verification)
 (flags -w +a-4-40-42-70 -warn-error +a-4-40-42-70)
 (libraries re rabbit_core rabbit_proverif_pv unix))

(rule
 (alias runtest)
 (target proverif_under_test.exe)
 (deps
  build_proverif_under_test.sh
  (source_tree ../../vendor/proverif/proverif))
 (action
  (run
   sh
   %{dep:build_proverif_under_test.sh}
   ../../vendor/proverif/proverif
   %{target})))

(rule
 (alias runtest)
 (deps
  (glob_files *.rab)
  (glob_files *.error))
 (action
  (run
   %{exe:test_proverif_verification.exe}
   %{dep:proverif_under_test.exe}
   .)))

(rule
 (alias runtest)
 (target cli_output.pv)
 (deps cli_output.rab)
 (action
  (run
   %{exe:../../src/rabbit_proverif.exe}
   %{dep:cli_output.rab}
   -o
   %{target})))

(rule
 (alias runtest)
 (targets multiple_event_warning.pv multiple_event_warning.stderr)
 (deps multiple_event_facts.rab)
 (action
  (progn
   (with-stderr-to multiple_event_warning.stderr
    (run
     %{exe:../../src/rabbit_proverif.exe}
     %{dep:multiple_event_facts.rab}
     -o
     multiple_event_warning.pv))
   (run
    %{bin:grep}
    -F
    "event [...] contains 2 facts; ProVerif emits them sequentially and cannot preserve their simultaneous occurrence"
    multiple_event_warning.stderr))))
