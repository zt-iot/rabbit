tag global [Never:0]

(* File facts have no event or query semantics and must be rejected by the typer. *)

type proc_t : process
type data_t : filesys

process worker() : proc_t
{
  file "/data" : data_t = "initial"

  main {
    event ["/data"."initial"]
  }
}

system worker()
requires
[
  lemma ModelRuns : (* falsified *) reachable ::Never()
]
