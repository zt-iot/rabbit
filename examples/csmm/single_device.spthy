    "All certification__165 deviceId__166 #time_1 . ReceiveCert(deviceId__166, certification__165)@#time_1 ==> Ex  #time_2 . IssueCert(deviceId__166, certification__165)@#time_2 & #time_2 < #time_1 "
lemma Authenticity_2 :
  all-traces
    "All certification__167 ctlrId__168 deviceId__169 #time_1 . SecCtlrAuth(ctlrId__168, deviceId__169, certification__167)@#time_1 ==> Ex  #time_2 . IssueCert(ctlrId__168, certification__167)@#time_2 & #time_2 < #time_1 "
lemma Accountability_1 :
  all-traces
    "All ctlrId__170 deviceId__171 #time_1 . RevokeCert(ctlrId__170, deviceId__171)@#time_1 ==> Ex  #time_2 . ReqRevocation(ctlrId__170, deviceId__171)@#time_2 & #time_2 < #time_1 "
lemma Accountability_2 :
  all-traces
    "All ctlrId__173 deviceId__174 #time_1 . ReqRevocation(ctlrId__173, deviceId__174)@#time_1 ==> Ex certification__172 #time_2 . SecCtlrAuth(ctlrId__173, deviceId__174, certification__172)@#time_2 & #time_2 < #time_1 "

