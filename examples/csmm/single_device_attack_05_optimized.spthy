//// Midamble

restriction Init : " All x #i #j . Init(x) @ #i & Init(x) @ #j ==> #i = #j "
restriction Equality_rule: "All x y #i. Eq(x,y) @ #i ==> x = y"
restriction NEquality_rule: "All x #i. NEq(x,x) @ #i ==> F"
lemma AlwaysStarts[reuse,use_induction]:
      "All x p #i. Loop_Back(x, p) @i ==> Ex #j. Loop_In(x, p) @j & j < i"

lemma AlwaysStartsWhenEnds[reuse,use_induction]:
      "All x p #i. Loop_Out(x, p) @i ==> Ex #j. Loop_In(x, p) @j & j < i"

lemma TransitionOnce[reuse,use_induction]:
      "All x p %i #j #k . Transition(x, p, %i) @#j & Transition(x, p, %i) @#k ==> #j = #k"

//// Lemmas

lemma Reachability_1 :
  exists-trace
    "Ex certification__250 ctlrId__251 deviceId__252 #time_0 . SecCtlrAuth(ctlrId__251, deviceId__252, certification__250)@#time_0 "

lemma Reachability_1a :
  exists-trace
    "Ex certificationCtlr__253 certificationDev__254 ctlrId__255 deviceId__256 #time_0  #time_1 . ReceiveCert(deviceId__256, certificationDev__254)@#time_0 & SecCtlrAuth(ctlrId__255, deviceId__256, certificationCtlr__253)@#time_1 "

lemma Reachability_2 :
  exists-trace
    "Ex certification__257 ctlrId__258 deviceId__259 #time_0 . RevokeCert(ctlrId__258, deviceId__259, certification__257)@#time_0 "

lemma Authenticity_1 :
  all-traces
    "All certification__260 deviceId__261 #time_1 . ReceiveCert(deviceId__261, certification__260)@#time_1 ==> Ex  #time_2 . IssueCert(deviceId__261, certification__260)@#time_2 & #time_2 < #time_1 "
lemma Authenticity_2 :
  all-traces
    "All certification__262 ctlrId__263 deviceId__264 #time_1 . SecCtlrAuth(ctlrId__263, deviceId__264, certification__262)@#time_1 ==> Ex  #time_2 . IssueCert(ctlrId__263, certification__262)@#time_2 & #time_2 < #time_1 "
lemma Accountability_1 :
  all-traces
    "All certification__265 ctlrId__266 deviceId__267 #time_1 . RevokeCert(ctlrId__266, deviceId__267, certification__265)@#time_1 ==> Ex  #time_2 . SecCtlrReqRevocation(ctlrId__266, deviceId__267, certification__265)@#time_2 & #time_2 < #time_1 "
lemma Accountability_2 :
  all-traces
    "All certificationDev__269 ctlrId__270 deviceId__271 #time_1 . SecCtlrReqRevocation(ctlrId__270, deviceId__271, certificationDev__269)@#time_1 ==> Ex certificationCtlr__268 #time_2 . SecCtlrAuth(ctlrId__270, deviceId__271, certificationCtlr__268)@#time_2 & #time_2 < #time_1 "
lemma ZeroDayResilience :
  all-traces "All ctlrId deviceId cert #i #j. BrokenDevice(deviceId)@i & SecCtlrReqRevocation(ctlrId, deviceId, cert)@j & i < j
    ==> not (Ex #k. DevReqRevocation(deviceId, cert)@k & i < k & k < j)"

end

