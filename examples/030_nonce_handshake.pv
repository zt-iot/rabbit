   in(ch2__124, store__chan(case_arg_0__142:bitstring));
   new channel_case_ch__143:channel;
   (out(channel_case_ch__143, (false__bool, (), n__125, ch2__124)) |
    in(channel_case_ch__143, (=false__bool, channel_case_result__166:bitstring, channel_case_state_0__167:bitstring, channel_case_state_1__168:bitstring))[precise];
    out(channel_case_ch__143, (true__bool, case_arg_0__142, channel_case_state_0__167, channel_case_state_1__168))) |
   in(channel_case_ch__143, (=true__bool, channel_case_done_result__144:bitstring, channel_case_done_state_0__145:bitstring, channel_case_done_state_1__146:bitstring))[precise];
   new case_ch__147:channel;
   ((out(case_ch__147, (false__bool, (), channel_case_done_state_0__145, channel_case_done_result__144, dec__0(channel_case_done_result__144, sym_k__0), fst__0(dec__0(channel_case_done_result__144, sym_k__0)), snd__0(dec__0(channel_case_done_result__144, sym_k__0)))) |
     in(case_ch__147, (=false__bool, case_result__154:bitstring, case_state_0__155:bitstring, case_state_1__156:bitstring, case_state_2__157:bitstring, case_state_3__158:bitstring, case_state_4__159:bitstring))[precise];
     if case_state_0__155 = case_state_4__159
     then
       event Valid__event_global(case_state_3__158, case_state_0__155);
       out(case_ch__147, (true__bool, (), case_state_0__155, case_state_1__156, case_state_2__157, case_state_3__158, case_state_4__159))
     else
       out(case_ch__147, (false__bool, case_result__154, case_state_0__155, case_state_1__156, case_state_2__157, case_state_3__158, case_state_4__159))) |
    in(case_ch__147, (=false__bool, case_result__160:bitstring, case_state_0__161:bitstring, case_state_1__162:bitstring, case_state_2__163:bitstring, case_state_3__164:bitstring, case_state_4__165:bitstring))[precise];
    if case_state_0__161 = case_state_4__165
    then
      out(case_ch__147, (false__bool, case_result__160, case_state_0__161, case_state_1__162, case_state_2__163, case_state_3__164, case_state_4__165))
    else
