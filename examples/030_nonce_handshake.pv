const person_t__0: proc_t.
(* type chan_t : channel *)
const chan_t__0: acc_data_t.
(* process alice(..): person_t *)
let alice__0(ptype:proc_t, ch__109:channel, ch2__110:channel) =
  (* Channel ch__109 : chan_t *)
  insert channel_table(chan_t__0, ch__109);
  (* Channel ch2__110 : chan_t *)
  insert channel_table(chan_t__0, ch2__110);
  get channel_table(ch_type__131:acc_data_t, =ch__109) in
  get access_control_table(=ptype, =ch_type__131, =recv__0__syscall) in
  in(ch__109, store__chan(case_arg_0__124:bitstring));
  new channel_case_ch__125:channel;
  (out(channel_case_ch__125, (false__bool, (), ch__109)) |
   in(channel_case_ch__125, (=false__bool, channel_case_result__129:bitstring, channel_case_state_0__130:bitstring))[precise];
   out(channel_case_ch__125, (true__bool, case_arg_0__124, channel_case_state_0__130))) |
  in(channel_case_ch__125, (=true__bool, channel_case_done_result__126:bitstring, channel_case_done_state_0__127:bitstring))[precise];
  new msg__112:bitstring;
  event Sent__event_global(msg__112, channel_case_done_result__126);
  get channel_table(ch_type__128:acc_data_t, =ch2__110) in
  get access_control_table(=ptype, =ch_type__128, =send__0__syscall) in
  out(ch2__110, store__chan(enc__0((msg__112, channel_case_done_result__126), sym_k__0))) |
  0.
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, ch__113:channel, ch2__114:channel) =
  (* Channel ch__113 : chan_t *)
  insert channel_table(chan_t__0, ch__113);
  (* Channel ch2__114 : chan_t *)
  insert channel_table(chan_t__0, ch2__114);
  new n__115:bitstring;
  get channel_table(ch_type__160:acc_data_t, =ch__113) in
  get access_control_table(=ptype, =ch_type__160, =send__0__syscall) in
  out(ch__113, store__chan(n__115)) |
  (get channel_table(ch_type__159:acc_data_t, =ch2__114) in
   get access_control_table(=ptype, =ch_type__159, =recv__0__syscall) in
   in(ch2__114, store__chan(case_arg_0__132:bitstring));
   new channel_case_ch__133:channel;
   (out(channel_case_ch__133, (false__bool, (), n__115, ch2__114)) |
    in(channel_case_ch__133, (=false__bool, channel_case_result__156:bitstring, channel_case_state_0__157:bitstring, channel_case_state_1__158:bitstring))[precise];
    out(channel_case_ch__133, (true__bool, case_arg_0__132, channel_case_state_0__157, channel_case_state_1__158))) |
   in(channel_case_ch__133, (=true__bool, channel_case_done_result__134:bitstring, channel_case_done_state_0__135:bitstring, channel_case_done_state_1__136:bitstring))[precise];
   new case_ch__137:channel;
   ((out(case_ch__137, (false__bool, (), channel_case_done_state_0__135, channel_case_done_result__134, dec__0(channel_case_done_result__134, sym_k__0), fst__0(dec__0(channel_case_done_result__134, sym_k__0)), snd__0(dec__0(channel_case_done_result__134, sym_k__0)))) |
     in(case_ch__137, (=false__bool, case_result__144:bitstring, case_state_0__145:bitstring, case_state_1__146:bitstring, case_state_2__147:bitstring, case_state_3__148:bitstring, case_state_4__149:bitstring))[precise];
     if case_state_0__145 = case_state_4__149
     then
       event Valid__event_global(case_state_3__148, case_state_0__145);
       out(case_ch__137, (true__bool, (), case_state_0__145, case_state_1__146, case_state_2__147, case_state_3__148, case_state_4__149))
     else
       out(case_ch__137, (false__bool, case_result__144, case_state_0__145, case_state_1__146, case_state_2__147, case_state_3__148, case_state_4__149))) |
    in(case_ch__137, (=false__bool, case_result__150:bitstring, case_state_0__151:bitstring, case_state_1__152:bitstring, case_state_2__153:bitstring, case_state_3__154:bitstring, case_state_4__155:bitstring))[precise];
    if case_state_0__151 = case_state_4__155
    then
      out(case_ch__137, (false__bool, case_result__150, case_state_0__151, case_state_1__152, case_state_2__153, case_state_3__154, case_state_4__155))
    else
      event Invalid__event_global;
      out(case_ch__137, (true__bool, (), case_state_0__151, case_state_1__152, case_state_2__153, case_state_3__154, case_state_4__155))) |
   in(case_ch__137, (=true__bool, case_done_result__138:bitstring, case_done_state_0__139:bitstring, case_done_state_1__140:bitstring, case_done_state_2__141:bitstring, case_done_state_3__142:bitstring, case_done_state_4__143:bitstring))[precise]).
(* channel chan : chan_t *)
free chan__0: channel[private].
(* channel chan2 : chan_t *)
free chan2__0: channel[private].
(* Requires *)
(* lemma Valid *)
query n__121:bitstring, msg__120:bitstring; 
  event(Valid__event_global(msg__120, n__121)).
(* lemma Invalid *)
query event(Invalid__event_global()).
(* lemma Correspondence *)
query n__123:bitstring, msg__122:bitstring; 
  event(Valid__event_global(msg__122, n__123)) ==> event(Sent__event_global(msg__122, n__123)).
(* System *)
process
  (* allow person_t chan_t [send] *)
  insert access_control_table(person_t__0, chan_t__0, send__0__syscall);
  (* allow person_t chan_t [recv] *)
  insert access_control_table(person_t__0, chan_t__0, recv__0__syscall);
  alice__0(person_t__0, chan__0, chan2__0) |
  bob__0(person_t__0, chan__0, chan2__0)
