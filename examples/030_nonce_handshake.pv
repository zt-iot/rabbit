(* process alice(..): person_t *)
let alice__0(ptype:proc_t, ch__119:channel, ch2__120:channel) =
  (* Channel ch__119 : chan_t *)
  insert channel_table(chan_t__0, ch__119);
  (* Channel ch2__120 : chan_t *)
