   in(case_ch__147, (=true__bool, case_done_result__148:bitstring, case_done_state_0__149:bitstring, case_done_state_1__150:bitstring, case_done_state_2__151:bitstring, case_done_state_3__152:bitstring, case_done_state_4__153:bitstring))[precise]).
(* channel chan : chan_t *)
free chan__0: channel[private].
(* channel chan2 : chan_t *)
free chan2__0: channel[private].
(* Requires *)
(* lemma Valid *)
query n__131:bitstring, msg__130:bitstring; 
  event(Valid__event_global(msg__130, n__131)).
(* lemma Invalid *)
query event(Invalid__event_global()).
(* lemma Correspondence *)
query n__133:bitstring, msg__132:bitstring; 
  event(Valid__event_global(msg__132, n__133)) ==> event(Sent__event_global(msg__132, n__133)).
(* System *)
process
