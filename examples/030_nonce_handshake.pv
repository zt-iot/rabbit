  get channel_table(ch_type__141:acc_data_t, =ch__119) in
  get access_control_table(=ptype, =ch_type__141, =recv__0__syscall) in
  in(ch__119, store__chan(case_arg_0__134:bitstring));
  new channel_case_ch__135:channel;
  (out(channel_case_ch__135, (false__bool, (), ch__119)) |
   in(channel_case_ch__135, (=false__bool, channel_case_result__139:bitstring, channel_case_state_0__140:bitstring))[precise];
   out(channel_case_ch__135, (true__bool, case_arg_0__134, channel_case_state_0__140))) |
  in(channel_case_ch__135, (=true__bool, channel_case_done_result__136:bitstring, channel_case_done_state_0__137:bitstring))[precise];
  new msg__122:bitstring;
  event Sent__event_global(msg__122, channel_case_done_result__136);
  get channel_table(ch_type__138:acc_data_t, =ch2__120) in
  get access_control_table(=ptype, =ch_type__138, =send__0__syscall) in
  out(ch2__120, store__chan(enc__0((msg__122, channel_case_done_result__136), sym_k__0))) |
  0.
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, ch__123:channel, ch2__124:channel) =
  (* Channel ch__123 : chan_t *)
  insert channel_table(chan_t__0, ch__123);
  (* Channel ch2__124 : chan_t *)
