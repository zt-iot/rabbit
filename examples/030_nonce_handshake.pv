(* equation dec(enc(x__103, y__104), y__104) = x__103 *)
equation forall x__103:bitstring, y__104:bitstring; dec__0(enc__0(x__103, y__104), y__104) = x__103.
(* const fresh sym_k *)
const sym_k__0: bitstring[private].
