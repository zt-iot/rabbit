theory rabbit

begin
builtins: natural-numbers


// The signature of our model:



functions: enc/2, dec/2
equations: dec(enc(loc_1, loc_0), loc_0)=loc_1

// Initializing the gloval constants and access policy rules:




// Constants:



// const fresh decryption_key


rule Const_decryption_key
  : [ Fr(decryption_key) ]
    --[ Init_('rab_Const_decryption_key'),
        !Const_('rab_decryption_key', decryption_key) ]->
    [ !Const_('rab_decryption_key', decryption_key) ]


// Add model inits: Worker


rule Init_system[role="system"]
  : [  ]
    --[ Init_('rab_system') ]->
    [ !ACP_GEN_('rab_system_', 'rab_rab_str'),
      State_Worker(<'rab___0', 'rab_rab_str', %1>, 'rab_unit', 'rab_empty', 'rab_empty', 'rab_empty') ]

// Model:  Worker


rule Worker_let_intro_event___0___2_5[role="Worker"]
  : [ State_Worker(<'rab___0', param, %v_>, return_var_0, 'rab_empty', 'rab_empty', 'rab_empty'),
      !Const_('rab_decryption_key', decryption_key_0) ]
    --[ Transition_(<'rab_Worker', param>, 'rab___0', %v_),
        DecryptionResult(dec('rab_not a ciphertext', decryption_key_0)) ]->
    [ State_Worker(<'rab___2', param, %v_>, 'rab_unit', 'rab_empty', dec('rab_not a ciphertext', decryption_key_0), 'rab_empty') ]

rule Worker_event_let_out___2___4_4[role="Worker"]
  : [ State_Worker(<'rab___2', param, %v_>, return_var_2, 'rab_empty', l_0_2, 'rab_empty') ]
    --[ Transition_(<'rab_Worker', param>, 'rab___2', %v_),
        Continued() ]->
    [ State_Worker(<'rab___4', param, %v_>, 'rab_unit', 'rab_empty', 'rab_empty', 'rab_empty') ]

restriction Init_ : " All x #i #j . Init_(x) @ #i & Init_(x) @ #j ==> #i = #j "
restriction Equality_rule: "All x y #i. Eq_(x,y) @ #i ==> x = y"
restriction NEquality_rule: "All x #i. NEq_(x,x) @ #i ==> F"

lemma AlwaysStarts_[reuse,use_induction]:
      "All x p #i. Loop_Back(x, p) @i ==> Ex #j. Loop_Start(x, p) @j & j < i"

lemma AlwaysStartsWhenEnds_[reuse,use_induction]:
      "All x p #i. Loop_Finish(x, p) @i ==> Ex #j. Loop_Start(x, p) @j & j < i"

lemma TransitionOnce_[reuse,use_induction]:
      "All x p %i #j #k . Transition_(x, p, %i) @#j &
        Transition_(x, p, %i) @ #k ==> #j = #k"


lemma UnreducedDecryptionContinues : exists-trace "Ex  #time_0 . Continued()@#time_0 "
lemma DecryptionResultIsReachable : exists-trace "Ex new_0 #time_0 . DecryptionResult(new_0)@#time_0 "
end

