(executable
  (name "test_proverif")
  (flags -w +a-4-40-42-70 -warn-error +a-4-40-42-70)
  (libraries rabbit_core rabbit_proverif_pv))

(rule
 (alias runtest)
 (deps
  (glob_files *.rab)
  (glob_files *.pv)
  (glob_files *.error))
 (action
  (run %{exe:proverif/test_proverif_examples.exe} .)))

(rule
 (alias runtest)
 (deps
  (glob_files *.rab)
  (glob_files *.pv)
  proverif_verification/proverif_under_test.exe)
 (action
  (run
   %{exe:proverif_verification/test_proverif_verification.exe}
   --expect-markers
   %{dep:proverif_verification/proverif_under_test.exe}
   .)))
