       in(case_ch__618, (=false__bool, case_result__629:bitstring, case_state_0__630:bitstring, case_state_1__631:bitstring, case_state_2__632:bitstring, case_state_3__633:bitstring))[precise];
       if case_state_3__633 = false__0
