         out(case_ch__618, (true__bool, (), case_state_0__630, case_state_1__631, case_state_2__632, case_state_3__633))
       else
         out(case_ch__618, (false__bool, case_result__629, case_state_0__630, case_state_1__631, case_state_2__632, case_state_3__633))) |
      in(case_ch__618, (=true__bool, case_done_result__619:bitstring, case_done_state_0__620:bitstring, case_done_state_1__621:bitstring, case_done_state_2__622:bitstring, case_done_state_3__623:bitstring))[precise];
      out(loop_ch__613, (false__bool, case_done_result__619))
      else out(loop_ch__613, (false__bool, loop_result__616))
      else out(loop_ch__613, (false__bool, loop_result__616))) |
     in(loop_ch__613, (=false__bool, loop_result__615:bitstring))[precise];
     out(loop_ch__613, (false__bool, loop_result__615)))) |
  in(loop_ch__613, (=true__bool, loop_done_result__614:bitstring))[precise].
(* process client(..): process_t *)
let client__0(ptype:proc_t, ch__606:channel) =
  (* Channel ch__606 : chan_t *)
