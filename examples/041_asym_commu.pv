        in(case_ch__618, (=false__bool, case_result__624:bitstring, case_state_0__625:bitstring, case_state_1__626:bitstring, case_state_2__627:bitstring, case_state_3__628:bitstring))[precise];
        if case_state_3__628 = true__0
