(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Structure declaration S(_,_,_) *)
fun S__struct(bitstring, bitstring, bitstring, bitstring): bitstring[data].
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; S__struct_addr(S__struct(x_0, x_1, x_2, x_3)) = x_0.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; S__struct_par_1(S__struct(x_0, x_1, x_2, x_3)) = x_1.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; S__struct_par_2(S__struct(x_0, x_1, x_2, x_3)) = x_2.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; S__struct_par_3(S__struct(x_0, x_1, x_2, x_3)) = x_3.
(* Event declaration ::Deleted(..) *)
event Deleted__event_global.
(* Event declaration ::Allocated(..) *)
event Allocated__event_global.
(* Integer constant 1 *)
const int__pos_1: bitstring.
(* Integer constant 2 *)
const int__pos_2: bitstring.
(* Integer constant 3 *)
const int__pos_3: bitstring.
(* Body *)
(* structure S(_,_,_) *)
(* type proc_t : process *)
const proc_t__0: proc_t.
(* process p(..): proc_t *)
let p__0(ptype:proc_t) =
  new x__831:bitstring;
  event Allocated__event_global;
  (* delete _.S *)
  insert deleted_address_table(S__struct_addr(S__struct(x__831, int__pos_1, int__pos_2, int__pos_3)));
  event Deleted__event_global.
(* Requires *)
(* lemma Reachable *)
query event(Deleted__event_global()).
(* lemma Correspondence *)
query event(Deleted__event_global()) ==> event(Allocated__event_global()).
(* System *)
process p__0(proc_t__0)
