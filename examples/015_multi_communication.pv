(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Channel fact declaration store(..) *)
fun store__chan(bitstring): bitstring[data].
(* syscall recv(..) *)
const recv__0__syscall: syscall_t.
(* syscall send(..) *)
const send__0__syscall: syscall_t.
(* Event declaration ::Sent(..) *)
event Sent__event_global.
(* Event declaration ::Valid(..) *)
event Valid__event_global.
(* Event declaration ::Received(..) *)
event Received__event_global.
(* Integer constant 1 *)
const int__pos_1: bitstring.
(* Body *)
(* type person_t : process *)
const person_t__0: proc_t.
(* type chan_t : channel *)
const chan_t__0: acc_data_t.
(* process alice(..): person_t *)
let alice__0(ptype:proc_t, ch__23:channel) =
  (* Channel ch__23 : chan_t *)
  insert channel_table(chan_t__0, ch__23);
  (* event [ ::Sent() ] at file "./015_multi_communication.rab", line 21, charaters 1-16 *)
  event Sent__event_global;
  (* _ := .. at file "./015_multi_communication.rab", line 22, charaters 1-17 *)
  (* put [ c__19::store(v__20) ] at file "./015_multi_communication.rab", line 6, charaters 2-19 *)
  get channel_table(ch_type__26:acc_data_t, =ch__23) in
  get access_control_table(=ptype, =ch_type__26, =send__0__syscall) in
  out(ch__23, store__chan(int__pos_1)) | 0.
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, ch__24:channel) =
  (* Channel ch__24 : chan_t *)
  insert channel_table(chan_t__0, ch__24);
  (* let one__25 = .. in .. at file "./015_multi_communication.rab", line 31, charaters 1-93 *)
  get channel_table(ch_type__28:acc_data_t, =ch__24) in
  get access_control_table(=ptype, =ch_type__28, =recv__0__syscall) in
  in(ch__24, store__chan(guard_arg_0__27:bitstring));
  (* event [ ::Received() ] at file "./015_multi_communication.rab", line 32, charaters 1-20 *)
  event Received__event_global;
  if guard_arg_0__27 = int__pos_1
  then
    (* event [ ::Valid() ] at file "./015_multi_communication.rab", line 35, charaters 5-21 *)
    event Valid__event_global.
(* channel chan : chan_t *)
free chan__0: channel[private].
(* Requires *)
(* lemma Reachable *)
query event(Valid__event_global()).
(* lemma Correspondent *)
query event(Received__event_global()) ==> event(Sent__event_global()).
(* System *)
process
  (* allow person_t chan_t [send] *)
  insert access_control_table(person_t__0, chan_t__0, send__0__syscall);
  (* allow person_t chan_t [recv] *)
  insert access_control_table(person_t__0, chan_t__0, recv__0__syscall);
  alice__0(person_t__0, chan__0) | bob__0(person_t__0, chan__0)
