(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Channel fact declaration store(..) *)
fun store__chan(bitstring): bitstring[data].
(* syscall recv(..) *)
const recv__0__syscall: syscall_t.
(* syscall send(..) *)
const send__0__syscall: syscall_t.
(* Event declaration ::Sent(..) *)
event Sent__event_global.
(* Event declaration ::Valid(..) *)
event Valid__event_global.
(* Event declaration ::Received(..) *)
event Received__event_global.
(* Integer constant 1 *)
const int__pos_1: bitstring.
(* Body *)
(* type person_t : process *)
const person_t__0: proc_t.
(* type chan_t : channel *)
const chan_t__0: acc_data_t.
(* process alice(..): person_t *)
let alice__0(ptype:proc_t, ch__33:channel) =
  (* Channel ch__33 : chan_t *)
  insert channel_table(chan_t__0, ch__33);
  event Sent__event_global;
  get channel_table(ch_type__36:acc_data_t, =ch__33) in
  get access_control_table(=ptype, =ch_type__36, =send__0__syscall) in
  out(ch__33, store__chan(int__pos_1)) | 0.
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, ch__34:channel) =
  (* Channel ch__34 : chan_t *)
  insert channel_table(chan_t__0, ch__34);
  get channel_table(ch_type__43:acc_data_t, =ch__34) in
  get access_control_table(=ptype, =ch_type__43, =recv__0__syscall) in
  in(ch__34, store__chan(case_arg_0__37:bitstring));
  new channel_case_ch__38:channel;
  (out(channel_case_ch__38, (false__bool, (), ch__34)) |
   in(channel_case_ch__38, (=false__bool, channel_case_result__41:bitstring, channel_case_state_0__42:bitstring))[precise];
   out(channel_case_ch__38, (true__bool, case_arg_0__37, channel_case_state_0__42))) |
  in(channel_case_ch__38, (=true__bool, channel_case_done_result__39:bitstring, channel_case_done_state_0__40:bitstring))[precise];
  event Received__event_global;
  if channel_case_done_result__39 = int__pos_1 then event Valid__event_global.
(* channel chan : chan_t *)
free chan__0: channel[private].
(* Requires *)
(* lemma Reachable *)
query event(Valid__event_global()).
(* lemma Correspondent *)
query event(Received__event_global()) ==> event(Sent__event_global()).
(* System *)
process
  (* allow person_t chan_t [send] *)
  insert access_control_table(person_t__0, chan_t__0, send__0__syscall);
  (* allow person_t chan_t [recv] *)
  insert access_control_table(person_t__0, chan_t__0, recv__0__syscall);
  alice__0(person_t__0, chan__0) | bob__0(person_t__0, chan__0)
