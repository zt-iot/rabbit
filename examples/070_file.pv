(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Structure declaration Fd(_) *)
fun Fd__struct(bitstring, bitstring): bitstring[data].
reduc
  forall x_0:bitstring, x_1:bitstring; Fd__struct_addr(Fd__struct(x_0, x_1)) = x_0.
reduc
  forall x_0:bitstring, x_1:bitstring; Fd__struct_par_1(Fd__struct(x_0, x_1)) = x_1.
(* syscall fclose(..) *)
const fclose__0__syscall: syscall_t.
(* syscall fread(..) *)
const fread__0__syscall: syscall_t.
(* syscall fopen(..) *)
const fopen__0__syscall: syscall_t.
(* Event declaration ::Valid(..) *)
event Valid__event_global.
(* String constant "/secret/pub" *)
const secret_pub__str: bitstring.
(* String constant "hello" *)
const hello__str: bitstring.
(* Body *)
(* structure Fd(_) *)
(* type server_t : process *)
const server_t__0: proc_t.
(* type readonly_t : filesys *)
const readonly_t__0: acc_data_t.
(* process server(..): server_t *)
let server__0(ptype:proc_t) =
  (* file "/secret/pub" : readonly_t = .. *)
  insert file_type_table(ptype, readonly_t__0, secret_pub__str);
  new file_ch:channel;
  out(file_ch, (secret_pub__str, hello__str)) |
  (get file_type_table(=ptype, file_type__799:acc_data_t, =secret_pub__str)
   in
   get access_control_table(=ptype, =file_type__799, =fopen__0__syscall) in
   in(file_ch, (=secret_pub__str, file_contents__797:bitstring))[precise];
   new y__791:bitstring;
   get file_type_table(=ptype, file_type__798:acc_data_t, =secret_pub__str)
   in
   get access_control_table(=ptype, =file_type__798, =fopen__0__syscall) in
   out(file_ch, (secret_pub__str, file_contents__797)) |
   (get deleted_address_table(=Fd__struct_addr(Fd__struct(y__791, file_contents__797)))
    else
      (* delete _.Fd *)
      insert deleted_address_table(Fd__struct_addr(Fd__struct(y__791, file_contents__797)));
      event Valid__event_global)).
(* Requires *)
(* lemma Reachable *)
query event(Valid__event_global()).
(* System *)
process
  (* allow server_t readonly_t [fopen] *)
  insert access_control_table(server_t__0, readonly_t__0, fopen__0__syscall);
  server__0(server_t__0)
