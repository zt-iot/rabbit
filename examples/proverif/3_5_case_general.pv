(* Predefined types *)
type param_data.
type rabbit_proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(rabbit_proc_t, acc_data_t, syscall_t).
table file_type_table(rabbit_proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none_syscall_s: syscall_t.
(* Booleans *)
const rabbit_true: bitstring.
const rabbit_false: bitstring.
(* Event declaration ::Valid(..) *)
event Valid.
(* Event declaration ::Unexpected(..) *)
event Unexpected.
(* Event declaration ::Invalid(..) *)
event Invalid.
(* Integer constant 1 *)
const rabbit_int_1: bitstring.
(* Integer constant 2 *)
const rabbit_int_2: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t: rabbit_proc_t.
(* process chooser(..): proc_t *)
let chooser(ptype:rabbit_proc_t) =
  new rabbit_case_ch__21:channel;
  ((out(rabbit_case_ch__21, rabbit_true) |
    in(rabbit_case_ch__21, _:bitstring)[precise];
    if rabbit_int_1 = rabbit_int_1
    then
      if rabbit_int_2 = rabbit_int_2 then event Valid
      else out(rabbit_case_ch__21, rabbit_true)
    else out(rabbit_case_ch__21, rabbit_true)) |
   in(rabbit_case_ch__21, _:bitstring)[precise];
   if rabbit_int_1 = rabbit_int_1
   then
     if rabbit_int_2 = rabbit_int_2 then out(rabbit_case_ch__21, rabbit_true)
     else event Unexpected
   else out(rabbit_case_ch__21, rabbit_true)) |
  in(rabbit_case_ch__21, _:bitstring)[precise];
  if rabbit_int_1 = rabbit_int_1 then out(rabbit_case_ch__21, rabbit_true)
  else event Invalid.
(* Requires *)
(* lemma ReachableValid *)
query event(Valid()).
(* System *)
process chooser(proc_t).
