const proc_t__0: proc_t.
(* process speaker(..): proc_t *)
let speaker__0(ptype:proc_t) =
  event Seen__event_global(hello__str);
  event Seen__event_global(hello__str).
(* Requires *)
(* lemma ReachableHello *)
query event(Seen__event_global(hello__str)).
(* System *)
process speaker__0(proc_t__0)
