(* Spec 3.1: a Rabbit string literal like "hello" is compiled to a generated
   ProVerif constant such as hello__str. *)

type proc_t : process

process speaker() : proc_t
{
  main {
    (* The same string literal is compiled to the same ident. *)
    event [::Seen("hello")]; (* const hello__str: bitstring. *)
    event [::Seen("hello")]
  }
}

system
  speaker()
requires
[
  lemma ReachableHello :
    reachable ::Seen("hello")
]
