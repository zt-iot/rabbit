(* process worker(..): proc_t *)
let worker(ptype:proc_t) =
  new rabbit_loop_ch__45:channel;
  (out(rabbit_loop_ch__45, (false, 0)) |
   !((in(rabbit_loop_ch__45, (=false, loop_state_0__48:bitstring))[precise];
      if loop_state_0__48 = 0 then out(rabbit_loop_ch__45, (false, 1))
      else out(rabbit_loop_ch__45, (false, loop_state_0__48))) |
     in(rabbit_loop_ch__45, (=false, loop_state_0__47:bitstring))[precise];
     if loop_state_0__47 = 1
     then out(rabbit_loop_ch__45, (true, loop_state_0__47))
     else out(rabbit_loop_ch__45, (false, loop_state_0__47)))) |
  in(rabbit_loop_ch__45, (=true, loop_done_state_0__46:bitstring))[precise];
