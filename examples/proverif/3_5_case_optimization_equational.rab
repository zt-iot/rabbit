(* Spec 3.5 optimization 1: mutually exclusive equational case branches can be
   merged into a single [if ... then ... else ...] tree. *)

type proc_t : process

process chooser() : proc_t
{
  main {
    var one = 1 in
    case
    | [one = 1] -> event [::Valid()]
    | [one != 1] -> event [::Invalid()]
    end
  }
}

system
  chooser()
requires
[
  lemma ReachableValid :
    reachable ::Valid()
]
