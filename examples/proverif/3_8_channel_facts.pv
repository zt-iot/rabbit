(* Predefined types *)
type param_data.
type rabbit_proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(rabbit_proc_t, acc_data_t, syscall_t).
table file_type_table(rabbit_proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none_syscall_s: syscall_t.
(* Booleans *)
const rabbit_true: bitstring.
const rabbit_false: bitstring.
(* Channel fact declaration store(..) *)
fun store(bitstring): bitstring[data].
(* Event declaration ::Valid(..) *)
event Valid.
(* Integer constant 1 *)
const rabbit_int_1: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t: rabbit_proc_t.
(* type chan_t : channel *)
const chan_t: acc_data_t.
(* process worker(..): proc_t *)
let worker(ptype:rabbit_proc_t, ch__60:channel) =
  (* Channel ch__60 : chan_t *)
  insert channel_table(chan_t, ch__60);
  get channel_table(ch_type__63:acc_data_t, =ch__60) in
  get access_control_table(=ptype, =ch_type__63, =none_syscall_s) in
  out(ch__60, store(rabbit_int_1)) |
  (get channel_table(ch_type__62:acc_data_t, =ch__60) in
   get access_control_table(=ptype, =ch_type__62, =none_syscall_s) in
   in(ch__60, store(case_arg_0__61:bitstring));
   if case_arg_0__61 = rabbit_int_1 then event Valid).
(* channel ch : chan_t *)
free ch: channel[private].
(* Requires *)
(* lemma ReachableValid *)
query event(Valid()).
(* System *)
process
  (* allow proc_t chan_t [.] *)
  insert access_control_table(proc_t, chan_t, none_syscall_s);
  worker(proc_t, ch).
