(* Event declaration ::Served(..) *)
event Served__event_global.
(* Body *)
(* type client_t : process *)
const client_t__0: proc_t.
(* type server_t : process *)
const server_t__0: proc_t.
(* type udp_t : channel *)
const udp_t__0: acc_data_t.
(* process client(..): client_t *)
let client__0(ptype:proc_t, ch__14:channel) =
