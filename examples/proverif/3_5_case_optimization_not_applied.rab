(* Spec 3.5 equational guards using the general encoding.

   This currently uses the private lock encoding. It does not test the optional
   optimization that merges exclusive guards into an if-then-else tree. *)

type proc_t : process

process chooser() : proc_t
{
  main {
    var one = 1 in
    case
    | [one = 1] -> event [::Valid()]
    | [one != 1] -> event [::Invalid()]
    end
  }
}

system
  chooser()
requires
[
  lemma ReachableValid :
    reachable ::Valid()
]
