(* Spec 3.1: generated string constants preserve the order of their first
   occurrence in the Rabbit source, rather than sorting by literal value. *)

type proc_t : process

process speaker() : proc_t
{
  main {
    event [::Seen("zebra")];
    event [::Seen("alpha")];
    (* These literals have the same sanitized base and therefore exercise the
       numeric collision suffix. *)
    event [::Seen("a-b")];
    event [::Seen("a b")]
  }
}

system
  speaker()
requires
[
  lemma ReachableAlpha :
    reachable ::Seen("alpha")
]
