(* Spec 3.5: a general non-channel Rabbit case

     case [A1] -> c1 | [A2] -> c2 | [A3] -> c3 end

   where each branch may use multiple equational guards,
   is compiled into a ProVerif conditional tree. In the current implementation,
   the generic non-channel path is still this nested [if ... then ... else ...]
   encoding.

   This example is intentionally separate from the equational optimization
   example: it uses three branches and branch-local conjunctions rather than
   just a two-way split on one equality. *)

type proc_t : process

process chooser() : proc_t
{
  main {
    var one = 1 in
    var two = 2 in
    case
    | [one = 1, two = 2]  -> event [::Valid()]
    | [one = 1, two != 2] -> event [::Unexpected()]
    | [one != 1]          -> event [::Invalid()]
     end
  }
}

system
  chooser()
requires
[
  lemma ReachableValid :
    reachable ::Valid()
]
