(* Spec 3.5: a general non-channel Rabbit case with a state-carrying join

     case [A1] -> c1 | [A2] -> c2 | [A3] -> c3 end

   Each branch receives the current process-variable state from a private lock
   channel and returns its updated state. A single continuation receives the
   selected branch's state. *)

type proc_t : process

process chooser() : proc_t
{
  main {
    var result = 0 in
    var one = 1 in
    var two = 2 in
    case
    | [one = 1, two = 2]  -> event [::Valid()]; result := 1
    | [one = 1, two != 2] -> event [::Unexpected()]; result := 2
    | [one != 1]          -> event [::Invalid()]; result := 3
    end;
    event [::Joined(result)]
  }
}

system
  chooser()
requires
[
  lemma ReachableValid :
    reachable ::Valid()
]
