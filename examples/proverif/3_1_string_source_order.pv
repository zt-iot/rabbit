(* Predefined types *)
type param_data.
type rabbit_proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(rabbit_proc_t, acc_data_t, syscall_t).
table file_type_table(rabbit_proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none_syscall_s: syscall_t.
(* Booleans *)
const rabbit_true: bitstring.
const rabbit_false: bitstring.
(* Event declaration ::Seen(..) *)
event Seen(bitstring).
(* String constant "zebra" *)
const zebra_str: bitstring.
(* String constant "alpha" *)
const alpha_str: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t: rabbit_proc_t.
(* process speaker(..): proc_t *)
let speaker(ptype:rabbit_proc_t) =
  event Seen(zebra_str);
  event Seen(alpha_str).
(* Requires *)
(* lemma ReachableAlpha *)
query event(Seen(alpha_str)).
(* System *)
process speaker(proc_t).
