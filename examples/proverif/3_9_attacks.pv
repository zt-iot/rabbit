table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* syscall id(..) *)
const id__0__syscall: syscall_t.
(* Event declaration ::Syscall(..) *)
event Syscall__event_global(bitstring).
(* Event declaration ::Attack(..) *)
event Attack__event_global(bitstring).
(* Event declaration ::Observed(..) *)
event Observed__event_global(bitstring).
(* Event declaration ::Sent(..) *)
event Sent__event_global(bitstring).
(* Integer constant 0 *)
const int__pos_0: bitstring.
(* Body *)
(* function succ:1 *)
fun succ__0(bitstring): bitstring.
(* type proc_t : process *)
const proc_t__0: proc_t.
(* process worker(..): proc_t *)
let worker__0(ptype:proc_t) =
  event Sent__event_global(int__pos_0);
  new call_join_ch__115:channel;
  (new attack_choice_ch:channel;
   (out(attack_choice_ch, true__bool) |
    in(attack_choice_ch, _:bitstring);
    event Syscall__event_global(int__pos_0);
    out(call_join_ch__115, (true__bool, int__pos_0))) |
   in(attack_choice_ch, _:bitstring);
   event Attack__event_global(int__pos_0);
   out(call_join_ch__115, (true__bool, succ__0(int__pos_0)))) |
  in(call_join_ch__115, (=true__bool, call_result__116:bitstring))[precise];
  event Observed__event_global(call_result__116).
(* Requires *)
(* lemma ReachableSyscall *)
query event(Syscall__event_global(int__pos_0)).
(* lemma ReachableAttack *)
query event(Attack__event_global(int__pos_0)).
(* System *)
process worker__0(proc_t__0)
