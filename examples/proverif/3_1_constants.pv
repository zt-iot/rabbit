(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Event declaration ::Seen(..) *)
event Seen__event_global(bitstring).
(* Body *)
(* type proc_t : process *)
const proc_t__0: proc_t.
(* const fresh secret *)
const secret__0: bitstring.
(* const alias = .. *)
const alias__0: bitstring.
equation alias__0 = secret__0.
(* process speaker(..): proc_t *)
let speaker__0(ptype:proc_t) =
  event Seen__event_global(secret__0);
  event Seen__event_global(alias__0).
(* Requires *)
(* lemma ReachableAlias *)
query event(Seen__event_global(alias__0)).
(* System *)
process speaker__0(proc_t__0).
