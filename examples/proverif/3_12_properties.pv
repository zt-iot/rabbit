(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Event declaration ::Finished(..) *)
event Finished__event_global.
(* Event declaration ::Started(..) *)
event Started__event_global.
(* Body *)
(* type proc_t : process *)
const proc_t__0: proc_t.
(* process worker(..): proc_t *)
let worker__0(ptype:proc_t) =
  event Started__event_global;
  event Finished__event_global.
(* Requires *)
(* lemma ReachableFinished *)
query event(Finished__event_global()).
(* lemma Correspondence *)
query event(Finished__event_global()) ==> event(Started__event_global()).
(* System *)
process worker__0(proc_t__0)
