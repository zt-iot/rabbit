(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Event declaration ::Selected(..) *)
event Selected__event_global(bitstring).
(* Integer constant 0 *)
const int__pos_0: bitstring.
(* Integer constant 1 *)
const int__pos_1: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t__0: proc_t.
(* process chooser(..): proc_t *)
let chooser__0(ptype:proc_t) =
  if int__pos_1 = int__pos_1 then event Selected__event_global(int__pos_1).
(* Requires *)
(* lemma UpdatedStateReachesContinuation *)
query event(Selected__event_global(int__pos_1)).
(* System *)
process chooser__0(proc_t__0)
