(* Spec 3.1: if Rabbit contains [event [:: ImgSend(image)]], the ProVerif
   translation should declare [event ImgSend(bitstring)]. *)

type proc_t : process

process sender() : proc_t
{
  main {
    new image in
    event [::ImgSend(image)]
  }
}

system
  sender()
requires
[
  lemma ReachableImgSend :
    reachable ::ImgSend(image)
]
