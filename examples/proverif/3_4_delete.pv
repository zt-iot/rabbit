(* Predefined types *)
type param_data.
type rabbit_proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(rabbit_proc_t, acc_data_t, syscall_t).
table file_type_table(rabbit_proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none_syscall_s: syscall_t.
(* Booleans *)
const rabbit_true: bitstring.
const rabbit_false: bitstring.
(* Structure declaration S(_,_,_) *)
fun S(bitstring, bitstring, bitstring, bitstring): bitstring[data].
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; SAddr(S(x_0, x_1, x_2, x_3)) = x_0.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; SPar1(S(x_0, x_1, x_2, x_3)) = x_1.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; SPar2(S(x_0, x_1, x_2, x_3)) = x_2.
reduc
  forall x_0:bitstring, x_1:bitstring, x_2:bitstring, x_3:bitstring; SPar3(S(x_0, x_1, x_2, x_3)) = x_3.
(* Event declaration ::Deleted(..) *)
event Deleted.
(* Integer constant 1 *)
const rabbit_int_1: bitstring.
(* Integer constant 2 *)
const rabbit_int_2: bitstring.
(* Integer constant 3 *)
const rabbit_int_3: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t: rabbit_proc_t.
(* process maker(..): proc_t *)
let maker(ptype:rabbit_proc_t) =
  new x__14:bitstring;
  (* delete _.S *)
  insert deleted_address_table(SAddr(S(x__14, rabbit_int_1, rabbit_int_2, rabbit_int_3)));
  event Deleted.
(* Requires *)
(* lemma ReachableDeleted *)
query event(Deleted()).
(* System *)
process maker(proc_t).
