event Deleted.
const proc_t: proc_t.
let maker(ptype:proc_t) =
  new x__14:bitstring;
  insert deleted_address_table(SAddr(S(x__14, 1, 2, 3))); event Deleted.
query event(Deleted()).
process maker(proc_t).
