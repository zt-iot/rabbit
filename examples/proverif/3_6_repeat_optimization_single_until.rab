(* Spec 3.6 potential optimization 2: when there is a single until branch, the
   exit message and continuation could be fused instead of routing through a
   separate done-state receive. This example is for checking that shape. *)

type proc_t : process

process worker() : proc_t
{
  main {
    var state = 0 in
    repeat
    | [state = 0] -> state := 1
    until
    | [state = 1] -> skip
    end;
    event [::Valid()]
  }
}

system
  worker()
requires
[
  lemma ReachableValid :
    reachable ::Valid()
]
