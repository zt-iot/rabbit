(* Predefined types *)
type param_data.
type rabbit_proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(rabbit_proc_t, acc_data_t, syscall_t).
table file_type_table(rabbit_proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none_syscall_s: syscall_t.
(* Booleans *)
const rabbit_true: bitstring.
const rabbit_false: bitstring.
(* Channel fact declaration store(..) *)
fun store(bitstring): bitstring[data].
(* Event declaration ::Valid(..) *)
event Valid.
(* Event declaration ::Invalid(..) *)
event Invalid.
(* Integer constant 1 *)
const rabbit_int_1: bitstring.
(* Integer constant 2 *)
const rabbit_int_2: bitstring.
(* Body *)
(* type proc_t : process *)
const proc_t: rabbit_proc_t.
(* type chan_t : channel *)
const chan_t: acc_data_t.
(* process chooser(..): proc_t *)
let chooser(ptype:rabbit_proc_t, ch__22:channel) =
  (* Channel ch__22 : chan_t *)
  insert channel_table(chan_t, ch__22);
  get channel_table(ch_type__26:acc_data_t, =ch__22) in
  get access_control_table(=ptype, =ch_type__26, =none_syscall_s) in
  out(ch__22, store(rabbit_int_1)) |
  (get channel_table(ch_type__25:acc_data_t, =ch__22) in
   get access_control_table(=ptype, =ch_type__25, =none_syscall_s) in
   in(ch__22, store(case_arg_0__23:bitstring));
   new rabbit_channel_case_ch__24:channel;
   (out(rabbit_channel_case_ch__24, rabbit_true) |
    in(rabbit_channel_case_ch__24, _:bitstring)[precise];
    if case_arg_0__23 = rabbit_int_1 then event Valid
    else out(rabbit_channel_case_ch__24, rabbit_true)) |
   in(rabbit_channel_case_ch__24, _:bitstring)[precise];
   if case_arg_0__23 = rabbit_int_2 then event Invalid
   else out(rabbit_channel_case_ch__24, rabbit_true)).
(* channel ch : chan_t *)
free ch: channel[private].
(* Requires *)
(* lemma ReachableValid *)
query event(Valid()).
(* System *)
process
  (* allow proc_t chan_t [.] *)
  insert access_control_table(proc_t, chan_t, none_syscall_s);
  chooser(proc_t, ch).
