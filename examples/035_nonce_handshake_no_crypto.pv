const person_t__0: proc_t.
(* type chan_t : channel *)
const chan_t__0: acc_data_t.
(* process alice(..): person_t *)
let alice__0(ptype:proc_t, ch__453:channel, ch2__454:channel) =
  (* Channel ch__453 : chan_t *)
  insert channel_table(chan_t__0, ch__453);
  (* Channel ch2__454 : chan_t *)
  insert channel_table(chan_t__0, ch2__454);
  get channel_table(ch_type__471:acc_data_t, =ch__453) in
  get access_control_table(=ptype, =ch_type__471, =recv__0__syscall) in
  in(ch__453, store__chan(case_arg_0__464:bitstring));
  new channel_case_ch__465:channel;
  (out(channel_case_ch__465, (false__bool, (), ch__453)) |
   in(channel_case_ch__465, (=false__bool, channel_case_result__469:bitstring, channel_case_state_0__470:bitstring))[precise];
   out(channel_case_ch__465, (true__bool, case_arg_0__464, channel_case_state_0__470))) |
  in(channel_case_ch__465, (=true__bool, channel_case_done_result__466:bitstring, channel_case_done_state_0__467:bitstring))[precise];
  new msg__456:bitstring;
  event Sent__event_global(msg__456, channel_case_done_result__466);
  get channel_table(ch_type__468:acc_data_t, =ch2__454) in
  get access_control_table(=ptype, =ch_type__468, =send__0__syscall) in
  out(ch2__454, store__chan(channel_case_done_result__466)) | 0.
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, ch__457:channel, ch2__458:channel) =
  (* Channel ch__457 : chan_t *)
  insert channel_table(chan_t__0, ch__457);
  (* Channel ch2__458 : chan_t *)
  insert channel_table(chan_t__0, ch2__458);
  new n__459:bitstring;
  get channel_table(ch_type__491:acc_data_t, =ch__457) in
  get access_control_table(=ptype, =ch_type__491, =send__0__syscall) in
  out(ch__457, store__chan(n__459)) |
  (get channel_table(ch_type__490:acc_data_t, =ch2__458) in
   get access_control_table(=ptype, =ch_type__490, =recv__0__syscall) in
   in(ch2__458, store__chan(case_arg_0__472:bitstring));
   new channel_case_ch__473:channel;
   (out(channel_case_ch__473, (false__bool, (), n__459, ch2__458)) |
    in(channel_case_ch__473, (=false__bool, channel_case_result__487:bitstring, channel_case_state_0__488:bitstring, channel_case_state_1__489:bitstring))[precise];
    out(channel_case_ch__473, (true__bool, case_arg_0__472, channel_case_state_0__488, channel_case_state_1__489))) |
   in(channel_case_ch__473, (=true__bool, channel_case_done_result__474:bitstring, channel_case_done_state_0__475:bitstring, channel_case_done_state_1__476:bitstring))[precise];
   new case_ch__477:channel;
   ((out(case_ch__477, (false__bool, (), channel_case_done_state_0__475, channel_case_done_result__474)) |
     in(case_ch__477, (=false__bool, case_result__481:bitstring, case_state_0__482:bitstring, case_state_1__483:bitstring))[precise];
     if case_state_0__482 = case_state_1__483
     then
       event Valid__event_global(case_state_0__482);
       out(case_ch__477, (true__bool, (), case_state_0__482, case_state_1__483))
     else
       out(case_ch__477, (false__bool, case_result__481, case_state_0__482, case_state_1__483))) |
    in(case_ch__477, (=false__bool, case_result__484:bitstring, case_state_0__485:bitstring, case_state_1__486:bitstring))[precise];
    if case_state_0__485 = case_state_1__486
    then
      out(case_ch__477, (false__bool, case_result__484, case_state_0__485, case_state_1__486))
    else
