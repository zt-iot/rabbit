      out(case_ch__477, (true__bool, (), case_state_0__485, case_state_1__486))) |
   in(case_ch__477, (=true__bool, case_done_result__478:bitstring, case_done_state_0__479:bitstring, case_done_state_1__480:bitstring))[precise]).
(* channel chan : chan_t *)
free chan__0: channel[private].
(* channel chan2 : chan_t *)
free chan2__0: channel[private].
(* Requires *)
(* lemma Valid *)
query n__461:bitstring; event(Valid__event_global(n__461)).
(* lemma Invalid *)
query event(Invalid__event_global()).
(* lemma Correspondence *)
query n__463:bitstring, msg__462:bitstring; 
  event(Valid__event_global(n__463)) ==> event(Sent__event_global(msg__462, n__463)).
(* System *)
process
  (* allow person_t chan_t [send] *)
  insert access_control_table(person_t__0, chan_t__0, send__0__syscall);
  (* allow person_t chan_t [recv] *)
  insert access_control_table(person_t__0, chan_t__0, recv__0__syscall);
  alice__0(person_t__0, chan__0, chan2__0) |
  bob__0(person_t__0, chan__0, chan2__0)
