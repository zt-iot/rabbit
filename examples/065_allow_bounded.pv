(* Predefined types *)
type param_data.
type proc_t.
type acc_data_t.
type syscall_t.
free attacker_ch: channel.
(* Tables *)
table access_control_table(proc_t, acc_data_t, syscall_t).
table file_type_table(proc_t, acc_data_t, bitstring).
table channel_table(acc_data_t, channel).
table deleted_address_table(bitstring).
(* Pattern which matches with any system call *)
const none__syscall: syscall_t.
(* Booleans *)
const true__bool: bitstring.
const false__bool: bitstring.
(* Channel fact declaration send(..) *)
fun send__chan(bitstring): bitstring[data].
(* syscall send_two(..) *)
const send_two__0__syscall: syscall_t.
(* syscall send_one(..) *)
const send_one__0__syscall: syscall_t.
(* Event declaration ::Valid(..) *)
event Valid__event_global.
(* Integer constant 2 *)
const int__pos_2: bitstring.
(* Integer constant 1 *)
const int__pos_1: bitstring.
(* Body *)
(* type person_t : process *)
const person_t__0: proc_t.
(* type chan_t : channel *)
const chan_t__0: acc_data_t.
(* process alice(..): person_t *)
let alice__0(ptype:proc_t, p__780:param_data, ch__781:channel) =
  (* Channel ch__781 : chan_t *)
  insert channel_table(chan_t__0, ch__781);
  get channel_table(ch_type__786:acc_data_t, =ch__781) in
  get access_control_table(=ptype, =ch_type__786, =send_one__0__syscall) in
  out(ch__781, send__chan(int__pos_1)) |
  (get channel_table(ch_type__785:acc_data_t, =ch__781) in
   get access_control_table(=ptype, =ch_type__785, =send_two__0__syscall) in
   out(ch__781, send__chan(int__pos_2)) | event Valid__event_global).
(* process bob(..): person_t *)
let bob__0(ptype:proc_t, p__782:param_data, ch__783:channel) =
  (* Channel ch__783 : chan_t *)
  insert channel_table(chan_t__0, ch__783);
  get channel_table(ch_type__788:acc_data_t, =ch__783) in
  get access_control_table(=ptype, =ch_type__788, =send_two__0__syscall) in
  out(ch__783, send__chan(int__pos_2)) |
  (get channel_table(ch_type__787:acc_data_t, =ch__783) in
   get access_control_table(=ptype, =ch_type__787, =send_one__0__syscall) in
   out(ch__783, send__chan(int__pos_1)) | event Valid__event_global).
(* channel chan : chan_t *)
free chan__0: channel[private].
(* Requires *)
(* lemma Reachable *)
query event(Valid__event_global()).
(* System *)
process
  (* allow person_t chan_t [send_one] *)
  insert access_control_table(person_t__0, chan_t__0, send_one__0__syscall);
  (* allow person_t chan_t [send_two] *)
  insert access_control_table(person_t__0, chan_t__0, send_two__0__syscall);
  !(new p__784:param_data;
    alice__0(person_t__0, p__784, chan__0) |
    bob__0(person_t__0, p__784, chan__0))
