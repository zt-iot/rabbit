type p : process
type c : channel
allow p c [.]
channel ch : c

process worker(ch : c) : p {
  main {
    repeat
    | [] -> event [::A()]; put [ch::Exit()]
    until
    | [ch::Exit()] -> skip
    end;
    event [::B()]
  }
}

system worker(ch)
requires [
  (* PROVERIF EXPECTED
  # One repeat emits A and Exit; consuming Exit then reaches B.
  true
  *)
  lemma Reverse : (* verified *) reachable ::B(), ::A()
]
